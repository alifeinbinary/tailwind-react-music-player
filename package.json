{
  "name": "tailwind-react-music-player",
  "version": "4.24.2",
  "description": "Maybe the best beautiful HTML5 responsive player component for react",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "unpkg": "dist/tailwind-react-music-player.min.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "assets",
    "LICENCE"
  ],
  "scripts": {
    "start": "yarn demo",
    "build:clean": "rimraf dist assets",
    "lint": "yarn lint:js && yarn lint:style",
    "lint:fix": "yarn lint-fix:js && yarn lint-fix:style",
    "lint:js": "./node_modules/.bin/eslint ./src ./__tests__ --ext .ts,.tsx",
    "lint:style": "stylelint '{example,src}/**/*.css'",
    "lint-fix:js": "yarn lint:js --fix",
    "lint-fix:style": "yarn lint:style --fix",
    "typecheck": "tsc --noEmit",
    "build:css": "tailwindcss -i src/styles/index.css -o assets/index.css --minify",
    "build:js": "yarn build:bundle && yarn build:umd",
    "build:bundle": "vite build",
    "build:umd": "vite build --mode umd",
    "build": "yarn build:clean && yarn build:js && yarn build:css && yarn copy:module-css",
    "copy:module-css": "cp ./assets/index.css ./assets/index.module.css",
    "build:demo": "vite build example",
    "build:netlify": "cross-env NETLIFY=1 yarn build:demo",
    "build:surge": "cross-env SURGE=1 yarn build:demo",
    "demo": "vite example",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ci:coverage": "yarn test:coverage && codecov",
    "prepublishOnly": "yarn build",
    "prettier": "prettier -c --write '**/*'",
    "pretty:quick": "pretty-quick",
    "lint-staged": "lint-staged",
    "release": "semantic-release",
    "bundlesize": "bundlesize",
    "prepare": "husky install"
  },
  "config": {
    "commitizen": {
      "path": "cz-emoji"
    }
  },
  "sideEffects": [
    "assets/*",
    "dist/*",
    "*.css"
  ],
  "lint-staged": {
    "*.{css,json}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "author": "Andrew Halliwell <andrew@alifeinbinary.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/alifeinbinary/react-music-player"
  },
  "homepage": "https://alifeinbinary.github.io/react-music-player",
  "bugs": {
    "url": "https://github.com/alifeinbinary/react-music-player/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "reactjs",
    "player",
    "music",
    "audio",
    "react-player",
    "tailwind-react-music-player",
    "react-music-player",
    "react-audio-player",
    "cd-player",
    "music-player",
    "audio-player",
    "component"
  ],
  "dependencies": {
    "@react-icons/all-files": "^4.1.0",
    "classnames": "^2.5.1",
    "downloadjs": "^1.4.7",
    "is-mobile": "^2.2.2",
    "prop-types": "^15.8.1",
    "rc-slider": "^9.7.2",
    "rc-switch": "^3.2.2",
    "react-draggable": "^4.7.2",
    "sortablejs": "^1.15.7"
  },
  "bundlesize": [
    {
      "path": "./dist/tailwind-react-music-player.min.js",
      "maxSize": "250 kB"
    }
  ],
  "devDependencies": {
    "@commitlint/config-conventional": "^12.1.1",
    "@semantic-release/changelog": "^5.0.1",
    "@semantic-release/git": "^9.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/downloadjs": "^1",
    "@types/enzyme": "^3",
    "@types/enzyme-adapter-react-16": "^1",
    "@types/node": "^24",
    "@types/prop-types": "^15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "bundlesize": "^0.18.1",
    "codecov": "^3.8.3",
    "commitizen": "^4.3.2",
    "commitlint": "^12.1.1",
    "cross-env": "^7.0.3",
    "enzyme": "^3.11.0",
    "enzyme-adapter-react-16": "^1.15.8",
    "enzyme-to-json": "^3.6.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^3.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^6.0.0",
    "jsdom": "^16.5.3",
    "lint-staged": "^11.0.0",
    "prettier": "^2.2.1",
    "pretty-quick": "^3.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^3.0.2",
    "semantic-release": "^17.4.2",
    "stylelint": "^13.13.1",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-standard": "^22.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "resolutions": {
    "bundlesize/brotli-size": "4.0.0"
  }
}
