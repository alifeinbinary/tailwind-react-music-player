{
  "name": "tailwind-react-music-player",
  "version": "5.0.0-alpha.0",
  "description": "Accessible, themeable HTML5 music player component for React, styled with Tailwind CSS",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENCE",
    "MIGRATION.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "yarn demo",
    "build:clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "yarn lint:js && yarn lint:style",
    "lint:fix": "yarn lint-fix:js && yarn lint-fix:style",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"{playground,src}/**/*.css\"",
    "lint-fix:js": "yarn lint:js --fix",
    "lint-fix:style": "yarn lint:style --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "gen:icons": "node scripts/gen-icons.ts",
    "build:bundle": "vite build",
    "build": "yarn build:clean && yarn build:bundle && yarn build:css",
    "build:demo": "vite build playground",
    "build:netlify": "NETLIFY=1 yarn build:demo",
    "build:surge": "SURGE=1 yarn build:demo",
    "demo": "vite playground",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "yarn build",
    "prettier": "prettier --check .",
    "format": "prettier --write .",
    "size": "size-limit",
    "check:package": "publint --pack npm && attw --pack . --exclude-entrypoints ./styles.css --ignore-rules cjs-resolves-to-esm",
    "smoke:import": "node -e \"import('./dist/index.js').then(()=>console.log('ESM import OK'))\"",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "author": "Andrew Halliwell <andrew@alifeinbinary.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alifeinbinary/react-music-player.git"
  },
  "homepage": "https://alifeinbinary.github.io/react-music-player",
  "bugs": {
    "url": "https://github.com/alifeinbinary/react-music-player/issues"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "reactjs",
    "player",
    "music",
    "audio",
    "react-player",
    "tailwind-react-music-player",
    "react-music-player",
    "react-audio-player",
    "cd-player",
    "music-player",
    "audio-player",
    "component"
  ],
  "dependencies": {
    "classnames": "^2.5.1",
    "react-draggable": "^4.7.2",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@microsoft/api-extractor": "^7.59.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^26",
    "lint-staged": "^17.6.0",
    "lucide-static": "^1.55.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semantic-release": "^24.2.9",
    "size-limit": "^14.1.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md,yml}": [
      "prettier --write"
    ]
  }
}
