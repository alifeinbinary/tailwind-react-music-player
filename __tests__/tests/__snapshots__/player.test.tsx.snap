exports[`<TailwindReactMusicPlayer/> > should render a <TailwindReactMusicPlayer/> components 1`] = `"<div class="tailwind-react-music-player-main touch-none font-[inherit] focus:outline-none dark-theme text-class-name" tabindex="-1"><div class="tailwind-react-music-player fixed w-(--rjmp-player-size) h-(--rjmp-player-size) z-999 max-md:w-(--rjmp-player-size-mobile) max-md:h-(--rjmp-player-size-mobile) focus:outline-none react-draggable" style="left: 0px; top: 0px; transform: translate(0px,0px);" tabindex="-1"><div class="music-player cursor-pointer relative w-(--rjmp-player-size) h-(--rjmp-player-size) max-md:w-(--rjmp-player-size-mobile) max-md:h-(--rjmp-player-size-mobile) focus:outline-none"><div id="music-player-controller" class="music-player-controller group w-(--rjmp-player-size) h-(--rjmp-player-size) rounded-[50%] border border-(--rjmp-controller-bg) bg-(--rjmp-controller-bg) text-(--rjmp-primary-color) shadow-[0_0_10px_rgba(0,0,0,0.15)] text-[20px] text-center transition-all duration-300 ease-(--rjmp-animate-type) z-99 p-2.5 fixed cursor-pointer bg-no-repeat bg-size-[100%] focus:outline-none flex items-center justify-center animate-[scaleTo_var(--rjmp-animate-time)_var(--rjmp-animate-type)_forwards] active:shadow-[0_0_30px_rgba(0,0,0,0.2)] hover:text-[16px] [&amp;_i]:text-[28px] max-md:w-(--rjmp-player-size-mobile) max-md:h-(--rjmp-player-size-mobile) max-md:hover:text-[12px] max-md:active:text-[12px] max-md:[&amp;_i]:text-[20px]" style="background-image: url();"><span class="controller-title text-sm"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M256 32C114.52 32 0 146.496 0 288v48a32 32 0 0 0 17.689 28.622l14.383 7.191C34.083 431.903 83.421 480 144 480h24c13.255 0 24-10.745 24-24V280c0-13.255-10.745-24-24-24h-24c-31.342 0-59.671 12.879-80 33.627V288c0-105.869 86.131-192 192-192s192 86.131 192 192v1.627C427.671 268.879 399.342 256 368 256h-24c-13.